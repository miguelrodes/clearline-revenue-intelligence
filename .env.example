# Copy to .env locally. Never paste keys into chat or commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_REASONING_EFFORT=high
CLEARLINE_DATA_DIR=data
CLEARLINE_DB_PATH=runtime/phase3/screening.sqlite3
CLEARLINE_AS_OF=2026-11-01
CLEARLINE_MAX_AGENT_TURNS=6
CLEARLINE_AGENT_TIMEOUT_SECONDS=120
CLEARLINE_MAX_OUTPUT_TOKENS=2500
CLEARLINE_FOLLOWUP_DAYS=7
# Local event logs are used; disable remote SDK trace uploads by default.
OPENAI_AGENTS_DISABLE_TRACING=1

# Independent account investigations in this single worker process.
CLEARLINE_CONCURRENCY=24
# Target 24 independent investigations; rate-limit backoff may temporarily reduce this.
CLEARLINE_MAX_CONCURRENCY=24
CLEARLINE_MAX_ATTEMPTS=5
CLEARLINE_ROUTINE_REASONING=medium
# Legacy settings retained for configuration compatibility; recovery investigations and reviews now both use OPENAI_REASONING_EFFORT.
CLEARLINE_HIGH_VALUE_CENTS=5000000

# Optional alternative interface; generate locally with python -m clearline.mcp_client configure.
CLEARLINE_MCP_TOKEN=
CLEARLINE_MCP_URL=http://127.0.0.1:8002/mcp

# Optional Secure MCP Tunnel. Restricted runtime key: Tunnels Read + Use.
# Separate from OPENAI_API_KEY; never use an admin key for the daemon.
CONTROL_PLANE_TUNNEL_ID=
CONTROL_PLANE_API_KEY=

# Complete evidence investigation plus independent review; bounded targeted revisions.
CLEARLINE_INVESTIGATION_TIMEOUT_SECONDS=480
CLEARLINE_INVESTIGATION_MAX_TOKENS=6000
CLEARLINE_QUALITY_MAX_REVISIONS=2
