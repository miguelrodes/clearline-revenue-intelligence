# Copy to .env locally. Never paste keys into chat or commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_REASONING_EFFORT=medium
CLEARLINE_DATA_DIR=/Users/miguelrodes/Downloads/clearline-case-study
CLEARLINE_DB_PATH=runtime/clearline.sqlite3
CLEARLINE_AS_OF=2026-11-01
CLEARLINE_MAX_AGENT_TURNS=6
CLEARLINE_AGENT_TIMEOUT_SECONDS=120
CLEARLINE_MAX_OUTPUT_TOKENS=2500
CLEARLINE_FOLLOWUP_DAYS=7
# Local event logs are used; disable remote SDK trace uploads by default.
OPENAI_AGENTS_DISABLE_TRACING=1
